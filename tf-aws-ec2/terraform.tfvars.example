# THIS IS THE FILE THAT ACTUALLY RUNS.
# Terraform loads terraform.tfvars automatically and its values beat the
# defaults in variables.tf. terraform.tfvars.example is only a template --
# fixing the example and not this file changes nothing.
#
# This file is gitignored, so it does not travel with the repo.
#
# Every value below is optional — each has a default in variables.tf.
# Uncomment only what you want to change.

# ---------------------------------------------------------------------------
# Region and naming
# ---------------------------------------------------------------------------

# KodeKloud playground usually hands you us-east-1.
aws_region = "us-east-1"

# Prefix for every resource name and tag.
# cluster_name = "cka"

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------

# Lock SSH and the API to your own IP:  curl -s ifconfig.me
# Leave as 0.0.0.0/0 only on a short-lived playground account.
allowed_cidr = "0.0.0.0/0"

# Generate first:  ssh-keygen -t ed25519 -f ~/.ssh/kubeadm-lab -N ""
ssh_public_key_path = "~/.ssh/kubeadm-lab.pub"

# ---------------------------------------------------------------------------
# Compute
# ---------------------------------------------------------------------------

# AMI. Two modes, no code editing needed to switch between them:
#
#   "ami-..."  pin an ID. Skips the AMI lookup, fastest apply. Lab default.
#   ""         auto-look-up the latest Ubuntu 24.04 AMI for this region.
#
# AMI IDs are REGION-SPECIFIC.
#
# DELIBERATE CHOICE: pinned, for apply speed. Verified working 16 Sep 2026.
# The cost is a hard failure -- "InvalidAMIID.NotFound", with an error that does
# not explain itself -- on the day AWS deprecates this AMI, or the day the
# playground hands you a region other than us-east-1.
#
# If that happens the fix is one line: set this to "" and the lookup in
# compute.tf finds the current Ubuntu 24.04 image for whatever region you are
# in. Nothing else changes.
instance_ami = "ami-0b6d9d3d33ba97d99" # Ubuntu 24.04, us-east-1

# The base jump host runs nothing but SSH — t3.micro is plenty.
base_instance_type = "t3.micro"

# Control plane. 2 vCPU is a kubeadm hard requirement -- do not shrink this.
instance_type = "t3.medium"

# Workers, sized separately from the control plane.
# NOTE: this is a MEMORY lever, not a vCPU lever. Every t3 size up to t3.large
# has 2 vCPUs, so t3.medium -> t3.small halves RAM (4 GiB -> 2 GiB) and changes
# nothing about vCPU. If a vCPU quota blocks the apply, the only fix is fewer
# instances: worker_count = 1 takes you from 8 vCPU to 6.
worker_instance_type = "t3.medium"

# 2 is the working default for this study plan. One worker blocks drain,
# anti-affinity, topology spread and cross-node service routing.
worker_count = 2

root_volume_size = 30

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------

# Node IPs are derived from subnet_cidr:
#   base .5   cp .10   node01 .11   node02 .12
vpc_cidr    = "10.0.0.0/16"
subnet_cidr = "10.0.1.0/24"

# NOTE: the POD network CIDR is NOT a Terraform variable.
# It lives in scripts/master.sh (POD_CIDR="192.168.0.0/16") because that is
# where `kubeadm init --pod-network-cidr` is actually called, and it must match
# what Calico expects. If you change it there, make sure it still does not
# overlap vpc_cidr above.